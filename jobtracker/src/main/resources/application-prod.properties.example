# ===================================================================
# JobTracker Production Configuration Template (application-prod.properties.example)
# Copy this file to application-prod.properties or configure via Environment Variables.
# NEVER commit real production credentials to source control.
# ===================================================================

# Application
spring.application.name=jobtracker
server.port=${PORT:8081}

# ===================================================================
# Production MySQL Database
# ===================================================================
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/jobtracker?useSSL=true&requireSSL=true&allowPublicKeyRetrieval=false&serverTimezone=UTC}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:jobtracker_user}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:CHANGE_ME_IN_PRODUCTION}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===================================================================
# JPA / Hibernate (Production mode: validate schema)
# ===================================================================
spring.jpa.hibernate.ddl-auto=${HIBERNATE_DDL_AUTO:validate}
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.open-in-view=false

# ===================================================================
# File Upload Configuration
# ===================================================================
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
file.upload-dir=${FILE_UPLOAD_DIR:uploads/resumes}

# ===================================================================
# JWT Authentication
# Must be a 256-bit+ secure Base64-encoded secret key
# ===================================================================
jwt.secret=${JWT_SECRET:CHANGE_ME_TO_A_SECURE_256BIT_BASE64_SECRET}
jwt.expiration=${JWT_EXPIRATION:86400000}

# ===================================================================
# CORS Configuration (Production origins only)
# ===================================================================
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:https://your-production-frontend.com}

# ===================================================================
# SMTP Mail Configuration
# ===================================================================
spring.mail.host=${SPRING_MAIL_HOST:smtp.gmail.com}
spring.mail.port=${SPRING_MAIL_PORT:587}
spring.mail.username=${SPRING_MAIL_USERNAME:your-email@example.com}
spring.mail.password=${SPRING_MAIL_PASSWORD:CHANGE_ME_APP_PASSWORD}
spring.mail.from=${SPRING_MAIL_FROM:noreply@jobtracker.com}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# ===================================================================
# Google Gemini AI Integration
# ===================================================================
gemini.api.key=${GEMINI_API_KEY:CHANGE_ME_GEMINI_KEY}
gemini.api.url=${GEMINI_API_URL:https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent}

# ===================================================================
# Logging Configuration
# ===================================================================
logging.level.root=WARN
logging.level.com.vasudev.jobtracker=INFO
logging.level.org.springframework.security=WARN
